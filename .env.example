# Vorlage für .env neben der docker-compose.yml. Alle Werte sind optional;
# ohne .env gelten die hier genannten Vorgaben.

# Port, unter dem der Dienst auf dem Host erreichbar ist (innen immer 8080).
ALKIS_PORT=8080

# Zeitlimit für eine einzelne Anfrage an einen Landesdienst, in Sekunden.
ALKIS_UPSTREAM_TIMEOUT_SECS=30

# Vorgabe und Obergrenze für den limit-Parameter der API.
ALKIS_DEFAULT_LIMIT=5000
ALKIS_MAX_LIMIT=5000

# Obergrenze der Cache-Datei auf der Festplatte (redb, unter /data im
# Container). Bei Erreichen wirft der Dienst die ältesten Kacheln weg, bleibt
# aber korrekt. Für dauerhafte bundesweite Abdeckung eher 32gb ansetzen.
ALKIS_CACHE_MAX_SIZE=2gb

# Nur nötig hinter einem Reverse Proxy, dessen öffentliche Adresse nicht im
# Host-Header steht. OGC API Features verlangt absolute Links, und QGIS folgt
# ihnen wörtlich — steht hier die falsche Adresse, lädt der Layer nicht.
# ALKIS_PUBLIC_URL=https://alkis.example.org

# Protokollierung. alkis_proxy=debug zeigt jede Anfrage mit bbox und Client.
RUST_LOG=alkis_proxy=info,tower_http=warn

# Antwortkompression abschalten. Nur setzen, wenn ein Client damit Probleme
# hat — die Variable wirkt allein durch ihr Vorhandensein.
# ALKIS_DISABLE_COMPRESSION=1
